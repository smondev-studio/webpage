---
---

<section
  id="contact"
  class="py-16 sm:py-20 lg:py-24 transition-colors duration-300 relative overflow-hidden"
  style="background-color: var(--bg-primary);"
>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-orange-500/[0.04] rounded-full blur-[150px] pointer-events-none"></div>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 sm:mb-12">
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-black mb-4"
        style="color: var(--text-primary);"
      >
        Contame sobre tu negocio
      </h2>
      <p class="text-base sm:text-lg" style="color: var(--text-muted);">
        Contame qué vendés y qué necesitás, y te respondo en menos de 24 horas.
      </p>
    </div>

    <form
      id="contact-form"
      class="rounded-3xl p-6 sm:p-8 flex flex-col gap-4 sm:gap-5 border transition-colors backdrop-blur-sm relative overflow-hidden"
      style="background: linear-gradient(135deg, var(--bg-card) 0%, rgba(249,115,22,0.04) 100%); border-color: var(--border);"
    >
      <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
        <div>
          <label
            for="contact-name"
            class="text-sm font-medium block mb-2"
            style="color: var(--text-muted);"
          >
            Nombre *
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            autocomplete="name"
            maxlength="100"
            required
            placeholder="Tu nombre"
            class="w-full rounded-xl px-4 py-3 outline-none transition-colors border"
            style="background-color: var(--input-bg); border-color: var(--border); color: var(--text-primary);"
          />
        </div>
        <div>
          <label
            for="contact-email"
            class="text-sm font-medium block mb-2"
            style="color: var(--text-muted);"
          >
            Email *
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            autocomplete="email"
            maxlength="100"
            aria-describedby="email-error"
            required
            placeholder="tu@email.com"
            class="w-full rounded-xl px-4 py-3 outline-none transition-colors border"
            style="background-color: var(--input-bg); border-color: var(--border); color: var(--text-primary);"
          />
          <p
            id="email-error"
            role="alert"
            class="hidden text-xs text-red-400 mt-1"
          >
            Ingresá un email válido.
          </p>
        </div>
      </div>

      <div>
        <label
          for="contact-business"
          class="text-sm font-medium block mb-2"
          style="color: var(--text-muted);"
        >
          ¿A qué se dedica tu negocio?
        </label>
        <input
          type="text"
          id="contact-business"
          name="business"
          maxlength="100"
          placeholder="Ej: Ropa, electrónica, artesanías..."
          class="w-full rounded-xl px-4 py-3 outline-none transition-colors border"
          style="background-color: var(--input-bg); border-color: var(--border); color: var(--text-primary);"
        />
      </div>

      <div>
        <label
          for="contact-message"
          class="text-sm font-medium block mb-2"
          style="color: var(--text-muted);"
        >
          Contame más *
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          maxlength="1000"
          required
          placeholder="¿Qué necesitás? ¿Tenés alguna tienda actualmente?"
          class="w-full rounded-xl px-4 py-3 outline-none transition-colors resize-none border"
          style="background-color: var(--input-bg); border-color: var(--border); color: var(--text-primary);"
        ></textarea>
        <p
          id="message-count"
          class="text-xs text-right mt-1"
          style="color: var(--text-muted);"
        >
          0/1000
        </p>
      </div>

      <!-- Honeypot anti-spam: invisible para personas; un bot lo completa y el backend descarta el mensaje. -->
      <div
        class="absolute -left-[9999px] top-auto w-px h-px overflow-hidden"
        aria-hidden="true"
      >
        <label for="contact-website">No completar este campo</label>
        <input
          type="text"
          id="contact-website"
          name="website"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div
        id="form-error"
        role="alert"
        class="hidden text-sm text-red-400 bg-red-500/10 border border-red-500/20 rounded-xl px-4 py-3"
      >
        <span id="error-message">
          No pude enviar tu mensaje. Probá de nuevo en unos minutos.
        </span>
      </div>
      <div
        id="form-success"
        role="status"
        class="hidden text-sm text-green-400 bg-green-500/10 border border-green-500/20 rounded-xl px-4 py-3 text-center"
      >
        ✅ ¡Listo! Recibí tu mensaje y te respondo en menos de 24 horas.
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full bg-orange-500 hover:bg-orange-400 text-white font-bold py-4 rounded-xl transition-all transform hover:scale-[1.02] shadow-lg shadow-orange-500/30 text-lg disabled:opacity-60 disabled:cursor-not-allowed disabled:scale-100 flex items-center justify-center gap-2"
      >
        <span id="btn-text">Enviar mensaje →</span>
        <svg
          id="btn-spinner"
          class="hidden animate-spin h-5 w-5 text-white"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
          ></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
      </button>

      <p class="text-xs text-center" style="color: var(--text-muted);">
        Uso tu nombre, email y mensaje solo para responderte.
      </p>
    </form>
  </div>
</section>

<script>
  import {
    collectMetadata,
    isValidEmail,
    submitContact,
    type ContactErrorCode,
  } from "../lib/contact";

  const ERROR_MESSAGES: Record<ContactErrorCode, string> = {
    name_required: "Escribí tu nombre.",
    email_required: "Ingresá tu email.",
    email_invalid: "Ingresá un email válido.",
    message_required: "Contame qué necesitás.",
    rate_limited:
      "Enviaste varios mensajes seguidos. Probá de nuevo en un rato.",
    invalid: "Revisá los datos e intentá de nuevo.",
    config_missing:
      "No pude enviar tu mensaje. Probá de nuevo en unos minutos.",
    server_error: "No pude enviar tu mensaje. Probá de nuevo en unos minutos.",
    network_error: "No pude enviar tu mensaje. Probá de nuevo en unos minutos.",
  };

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text")!;
  const btnSpinner = document.getElementById("btn-spinner")!;
  const errorBox = document.getElementById("form-error")!;
  const errorMessage = document.getElementById("error-message")!;
  const successBox = document.getElementById("form-success")!;
  const emailError = document.getElementById("email-error")!;
  const emailInput = form.querySelector<HTMLInputElement>('[name="email"]')!;
  const messageInput =
    form.querySelector<HTMLTextAreaElement>('[name="message"]')!;
  const messageCount = document.getElementById("message-count")!;

  function showError(code: ContactErrorCode, retryInMinutes?: number) {
    errorMessage.textContent =
      code === "rate_limited" && retryInMinutes
        ? `Enviaste varios mensajes seguidos. Probá de nuevo en ${retryInMinutes} minutos.`
        : ERROR_MESSAGES[code];
    errorBox.classList.remove("hidden");
  }

  messageInput.addEventListener("input", () => {
    messageCount.textContent = `${messageInput.value.length}/${messageInput.maxLength}`;
  });

  // Validación del email al salir del campo
  emailInput.addEventListener("blur", () => {
    const invalid = emailInput.value !== "" && !isValidEmail(emailInput.value);
    emailError.classList.toggle("hidden", !invalid);
    emailInput.setAttribute("aria-invalid", String(invalid));
    emailInput.style.borderColor = invalid ? "rgb(248 113 113)" : "";
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");
    successBox.classList.add("hidden");

    const data = new FormData(form);
    const field = (name: string) => String(data.get(name) ?? "");

    if (!isValidEmail(field("email"))) {
      emailError.classList.remove("hidden");
      emailInput.setAttribute("aria-invalid", "true");
      emailInput.focus();
      return;
    }

    btn.disabled = true;
    btnText.textContent = "Enviando...";
    btnSpinner.classList.remove("hidden");

    const result = await submitContact(
      {
        name: field("name").trim(),
        email: field("email").trim(),
        business: field("business").trim() || undefined,
        message: field("message").trim(),
        website: field("website"),
        ...collectMetadata(),
      },
      import.meta.env.PUBLIC_API_URL,
    );

    if (result.ok) {
      form.reset();
      messageCount.textContent = `0/${messageInput.maxLength}`;
      successBox.classList.remove("hidden");
    } else {
      showError(result.error, result.retryInMinutes);
    }

    btn.disabled = false;
    btnText.textContent = "Enviar mensaje →";
    btnSpinner.classList.add("hidden");
  });
</script>
