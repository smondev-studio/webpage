---
import Store from "@lucide/astro/icons/store";
import CreditCard from "@lucide/astro/icons/credit-card";
import ShoppingBag from "@lucide/astro/icons/shopping-bag";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";

const features = [
  {
    Icon: Store,
    title: "Una tienda con tu marca",
    description:
      "Tu logo, tus colores y tu banner, en tu propio subdominio o dominio. Tus datos son solo tuyos: nadie más los ve.",
  },
  {
    Icon: CreditCard,
    title: "Cobrás con Mercado Pago",
    description:
      "Tus clientes pagan con Mercado Pago y la plata va directo a tu cuenta. La orden se actualiza sola, sin que tengas que revisar si el pago se acreditó.",
  },
  {
    Icon: ShoppingBag,
    title: "Catálogo con talla y color",
    description:
      "Cada producto puede tener variantes con su propio stock. Se agota una talla y seguís vendiendo las demás.",
  },
  {
    Icon: LayoutDashboard,
    title: "La manejás vos",
    description:
      "Desde tu panel cargás productos, cambiás precios, el logo o el banner cuando quieras. No hace falta escribirme por un cambio chico.",
  },
];

const extras = [
  "Se ve bien en el celular",
  "Tus clientes entran con Google",
  "Tu tienda aparece en Google con tu nombre",
];

// Un solo acento (el naranja de marca) para las tarjetas.
const accent = "rgba(var(--blue-rgb),";
---

<section
  id="features"
  class="py-16 sm:py-20 lg:py-24 transition-colors duration-300 relative overflow-hidden"
  style="background: var(--band);"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-black mb-4 transition-colors"
        style="color: var(--text-primary);"
      >
        Qué incluye Store
      </h2>
      <p
        class="text-base sm:text-lg max-w-xl mx-auto"
        style="color: var(--text-muted);"
      >
        Todo esto ya está construido y funcionando hoy.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
      {features.map(({ Icon, title, description }) => {
        const a = accent;
        return (
          <div
            class="rounded-2xl p-6 transition-all duration-300 group cursor-default border backdrop-blur-sm relative overflow-hidden"
            style={`background: linear-gradient(135deg, var(--bg-card) 0%, ${a}0.06) 100%); border-color: var(--border);`}
          >
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`background: radial-gradient(circle at 50% 0%, ${a}0.12) 0%, transparent 70%);`}
            ></div>
            <div class="relative z-10">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 border transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg"
                style={`background: ${a}0.15); border-color: ${a}0.3); box-shadow: 0 0 20px ${a}0.1);`}
              >
                <Icon class="w-6 h-6" style={`color: ${a}1);`} />
              </div>
              <h3
                class="font-bold text-lg mb-2 group-hover:text-orange-500 transition-colors"
                style="color: var(--text-primary);"
              >
                {title}
              </h3>
              <p
                class="text-sm leading-relaxed"
                style="color: var(--text-muted);"
              >
                {description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <div class="flex flex-wrap justify-center gap-3 mt-10">
      {extras.map((label) => (
        <span
          class="text-sm px-4 py-1.5 rounded-full font-medium border"
          style="background-color: var(--bg-card); border-color: var(--border); color: var(--text-muted);"
        >
          {label}
        </span>
      ))}
    </div>
  </div>
</section>
