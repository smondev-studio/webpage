---
---

<section
  class="relative min-h-screen flex items-center overflow-hidden pt-16 transition-colors duration-300"
  style="background: var(--hero-gradient);"
>
  <!-- Decorative blobs -->
  <div class="absolute top-20 -right-20 w-[500px] h-[500px] bg-orange-500/[0.06] dark:bg-orange-500/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-72 h-72 bg-orange-500/8 dark:bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid lg:grid-cols-[0.7fr_1.3fr] gap-6 lg:gap-10 items-center">
      <!-- Text -->
      <div class="order-2 lg:order-1">
        <div class="inline-flex items-center gap-2 bg-orange-500/20 border border-orange-500/30 text-orange-500 text-xs font-semibold px-4 py-1.5 rounded-full mb-6">
          <span class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
          Disponible para nuevos proyectos
        </div>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-black leading-tight mb-6 transition-colors duration-300"
          style="color: var(--text-primary);"
        >
          Tu tienda online,
          <br />
          <span class="text-orange-500">hecha a medida</span>
          <br />y lista para vender.
        </h1>

        <p
          class="text-base sm:text-lg leading-relaxed mb-8 max-w-md transition-colors duration-300"
          style="color: var(--text-muted);"
        >
          Te armo la tienda con tu logo, tus colores y tu catálogo. Mercado Pago
          ya viene conectado y vos la manejás desde tu propio panel. Nada de
          plantillas compartidas.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="bg-orange-500 hover:bg-orange-400 text-white font-bold px-8 py-3.5 rounded-full transition-all transform hover:scale-105 shadow-lg shadow-orange-500/30"
          >
            Quiero mi tienda →
          </a>
          <a
            href="#features"
            class="font-semibold px-8 py-3.5 rounded-full transition-all border"
            style="border-color: var(--border); color: var(--text-muted);"
          >
            Ver qué incluye
          </a>
        </div>

        <!-- Stats -->
        <div class="flex gap-4 sm:gap-6 mt-10">
          <div>
            <div
              class="text-base sm:text-lg font-black whitespace-nowrap"
              style="color: var(--text-primary);"
            >
              Tu marca
            </div>
            <div
              class="text-xs mt-1 whitespace-nowrap"
              style="color: var(--text-faint);"
            >
              no una plantilla
            </div>
          </div>
          <div class="w-px" style="background-color: var(--border);"></div>
          <div>
            <div class="text-base sm:text-lg font-black whitespace-nowrap text-orange-500">
              Mercado Pago
            </div>
            <div
              class="text-xs mt-1 whitespace-nowrap"
              style="color: var(--text-faint);"
            >
              ya conectado
            </div>
          </div>
          <div class="w-px" style="background-color: var(--border);"></div>
          <div>
            <div
              class="text-base sm:text-lg font-black whitespace-nowrap"
              style="color: var(--text-primary);"
            >
              Panel propio
            </div>
            <div
              class="text-xs mt-1 whitespace-nowrap"
              style="color: var(--text-faint);"
            >
              lo manejás vos
            </div>
          </div>
        </div>
      </div>

      <!-- Hero image — CSS swaps on theme (sin parpadeo) -->
      <div class="relative flex justify-center items-center order-1 lg:order-2">
        <img
          src="/images/hero-dark.png"
          alt="SmonDev Studio"
          fetchpriority="high"
          class="theme-img-dark relative z-0 w-full h-auto object-contain drop-shadow-2xl rounded-2xl"
          style="max-height: 850px;"
        />
        <img
          src="/images/hero-light.png"
          alt="SmonDev Studio"
          fetchpriority="high"
          class="theme-img-light relative z-0 w-full h-auto object-contain drop-shadow-2xl rounded-2xl"
          style="max-height: 850px;"
        />
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce"
    style="color: var(--text-faint);"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="19 9l-7 7-7-7"
      />
    </svg>
  </div>
</section>
