---
import Zap from "@lucide/astro/icons/zap";
import Code from "@lucide/astro/icons/code";
import Server from "@lucide/astro/icons/server";
import LifeBuoy from "@lucide/astro/icons/life-buoy";

const steps = [
  {
    number: "01",
    title: "Me contás qué necesitás",
    description:
      "Hablamos por mensaje o llamada: qué problema tenés, cómo lo resolvés hoy y qué te gustaría que haga el sistema.",
    Icon: Zap,
  },
  {
    number: "02",
    title: "Lo diseño y desarrollo",
    description:
      "Armo la solución a tu medida, con tu marca y tus reglas de negocio — no una herramienta genérica adaptada a la fuerza.",
    Icon: Code,
  },
  {
    number: "03",
    title: "Lo pongo en producción",
    description:
      "Lo publico y lo dejo funcionando, con tu dominio si lo necesitás. Del desarrollo a que esté en uso, sin pasos en el medio.",
    Icon: Server,
  },
  {
    number: "04",
    title: "Te acompaño después",
    description:
      "Seguimos en contacto mientras te acostumbrás a usarlo — no te dejo solo el primer día.",
    Icon: LifeBuoy,
  },
];

const accent = "rgba(var(--blue-rgb),";
---

<section
  id="how-it-works"
  class="py-16 sm:py-20 lg:py-24 transition-colors duration-300 relative overflow-hidden"
  style="background-color: var(--bg-primary);"
>
  <div class="absolute top-0 right-0 w-96 h-96 bg-[rgba(var(--blue-rgb),0.07)] rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-orange-500/[0.04] rounded-full blur-[100px] pointer-events-none"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-black mb-4"
        style="color: var(--text-primary);"
      >
        ¿Cómo trabajo?
      </h2>
      <p class="text-base sm:text-lg" style="color: var(--text-muted);">
        De la primera charla a tenerlo funcionando, en 4 pasos.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {steps.map((step, i) => {
        const a = accent;
        return (
          <div class="relative">
            {i < steps.length - 1 && (
              <div class="hidden lg:block absolute top-8 left-full w-full h-px bg-gradient-to-r from-[rgba(var(--blue-rgb),0.4)] to-transparent z-0"></div>
            )}
            <div class="relative z-10 group">
              <div
                class="w-16 h-16 rounded-2xl flex items-center justify-center mb-4 border transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg"
                style={`background: ${a}0.15); border-color: ${a}0.3); box-shadow: 0 0 20px ${a}0.1);`}
              >
                <step.Icon class="w-8 h-8" style={`color: ${a}1);`} />
              </div>
              <h3
                class="font-bold text-lg mb-2"
                style="color: var(--text-primary);"
              >
                {step.title}
              </h3>
              <p
                class="text-sm leading-relaxed"
                style="color: var(--text-muted);"
              >
                {step.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
