---
import Zap from "@lucide/astro/icons/zap";
import Code from "@lucide/astro/icons/code";
import CreditCard from "@lucide/astro/icons/credit-card";
import Rocket from "@lucide/astro/icons/rocket";

const steps = [
  {
    number: "01",
    title: "Me contás tu negocio",
    description:
      "Hablamos por mensaje o llamada: qué vendés, cuántos productos tenés hoy, y qué te gustaría que se vea distinto de una tienda genérica.",
    Icon: Zap,
  },
  {
    number: "02",
    title: "Diseño y desarrollo",
    description:
      "Armo tu tienda con tu marca real — tu logo, tus colores, tu catálogo — no una plantilla con tu nombre pegado encima.",
    Icon: Code,
  },
  {
    number: "03",
    title: "Integración de pagos",
    description:
      "Conectamos tu propia cuenta de Mercado Pago: el dinero de cada venta va directo a la tuya, yo no toco un peso en el medio.",
    Icon: CreditCard,
  },
  {
    number: "04",
    title: "Lanzamiento y soporte",
    description:
      "La tienda sale al aire en tu dominio y seguimos en contacto mientras te acostumbrás a manejarla — no te dejo solo el primer día.",
    Icon: Rocket,
  },
];

// Un solo acento (naranja de marca) para los 4 pasos -- ídem Features,
// antes cada paso tenía un color distinto sin ningún significado real.
const accent = "rgba(249,115,22,";
---

<section
  id="how-it-works"
  class="py-16 sm:py-20 lg:py-24 transition-colors duration-300 relative overflow-hidden"
  style="background-color: var(--bg-primary);"
>
  <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-orange-500/[0.04] rounded-full blur-[100px] pointer-events-none"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-black mb-4"
        style="color: var(--text-primary);"
      >
        ¿Cómo funciona?
      </h2>
      <p class="text-base sm:text-lg" style="color: var(--text-muted);">
        Del primer contacto al lanzamiento en 4 pasos simples.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {steps.map((step, i) => {
        const a = accent;
        return (
          <div class="relative">
            {i < steps.length - 1 && (
              <div class="hidden lg:block absolute top-8 left-full w-full h-px bg-gradient-to-r from-orange-500/40 to-transparent z-0"></div>
            )}
            <div class="relative z-10 group">
              <div
                class="w-16 h-16 rounded-2xl flex items-center justify-center mb-4 border transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg"
                style={`background: ${a}0.15); border-color: ${a}0.3); box-shadow: 0 0 20px ${a}0.1);`}
              >
                <step.Icon class="w-8 h-8" style={`color: ${a}1);`} />
              </div>
              <h3
                class="font-bold text-lg mb-2"
                style="color: var(--text-primary);"
              >
                {step.title}
              </h3>
              <p
                class="text-sm leading-relaxed"
                style="color: var(--text-muted);"
              >
                {step.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
