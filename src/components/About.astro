---
import MapPin from "@lucide/astro/icons/map-pin";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
---

<section
  id="about"
  class="py-16 sm:py-20 lg:py-24 transition-colors duration-300 relative overflow-hidden"
  style="background-color: var(--bg-primary);"
>
  <div class="absolute top-10 right-10 w-96 h-96 bg-[rgba(var(--blue-rgb),0.07)] rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-[rgba(var(--blue-rgb),0.06)] rounded-full blur-[100px] pointer-events-none"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Photo -->
      <div class="relative flex justify-center md:justify-end">
        <div class="relative w-72 sm:w-80">
          <div
            class="absolute -inset-4 rounded-3xl opacity-30 blur-xl"
            style="background: linear-gradient(135deg, rgba(249,115,22,0.35), rgba(249,115,22,0.1));"
          ></div>
          <div
            class="relative rounded-3xl overflow-hidden border-2 transition-colors"
            style="border-color: var(--border); background: linear-gradient(135deg, var(--bg-card) 0%, rgba(249,115,22,0.06) 100%);"
          >
            <img
              src="/images/hero-dark.webp"
              alt="SmonDev Studio"
              loading="lazy"
              class="theme-img-dark w-full h-auto object-contain"
            />
            <img
              src="/images/hero-light.webp"
              alt="SmonDev Studio"
              loading="lazy"
              class="theme-img-light w-full h-auto object-contain"
            />
          </div>
          <!-- Location badge -->
          <div
            class="absolute -bottom-4 -right-4 rounded-2xl px-5 py-3 border backdrop-blur-md shadow-lg transition-colors"
            style="background-color: var(--bg-card); border-color: var(--border);"
          >
            <div
              class="flex items-center gap-2 text-sm font-semibold"
              style="color: var(--text-primary);"
            >
              <MapPin class="w-4 h-4 text-orange-500" />
              Cipolletti, Río Negro
            </div>
          </div>
        </div>
      </div>

      <!-- Text -->
      <div>
        <div class="inline-flex items-center gap-2 bg-orange-500/15 border border-orange-500/30 text-orange-500 text-xs font-semibold px-4 py-1.5 rounded-full mb-6">
          <GraduationCap class="w-3.5 h-3.5" />
          Universidad Nacional del Comahue
        </div>

        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-black mb-6 transition-colors"
          style="color: var(--text-primary);"
        >
          Detrás de <span class="text-orange-500">SmonDev Studio</span>
        </h2>

        <div
          class="space-y-4 text-base leading-relaxed"
          style="color: var(--text-muted);"
        >
          <p>
            Soy desarrollador de software, graduado de la Universidad Nacional
            del Comahue. Trabajo desde Cipolletti, en la Patagonia argentina.
          </p>
          <p>
            SmonDev Studio es mi estudio: desarrollo software a medida y me
            ocupo yo mismo de cada proyecto, desde la idea hasta que está
            funcionando en producción.
          </p>
        </div>

        <div class="flex flex-wrap gap-3 mt-8">
          {["Desarrollo de software", "Patagonia", "Argentina"].map((label) => (
            <span
              class="text-sm px-4 py-1.5 rounded-full font-medium border transition-colors hover:scale-105"
              style="background-color: var(--bg-card); border-color: var(--border); color: var(--text-muted);"
            >
              {label}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
