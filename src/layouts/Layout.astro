---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SmonDev Studio — Desarrollo de software a medida y tiendas online",
  description = "Desarrollo de software a medida desde la Patagonia argentina. Además, Store: mi plataforma de tiendas online con tu marca, panel propio y Mercado Pago ya conectado.",
} = Astro.props;

import "../styles/global.css";
import Analytics from "../components/Analytics.astro";

const SITE_URL = "https://smondevstudio.com";

// Solo hechos confirmados: estudio de software en Cipolletti, Río Negro, que además
// tiene Store (tiendas online). Lo que se declara acá tiene que verse en la página.
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "SmonDev Studio",
  url: SITE_URL,
  logo: `${SITE_URL}/favicon-192.png`,
  image: `${SITE_URL}/images/og-image.jpg`,
  description:
    "Estudio de desarrollo de software a medida, y creador de Store, una plataforma de tiendas online con Mercado Pago.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Cipolletti",
    addressRegion: "Río Negro",
    addressCountry: "AR",
  },
  areaServed: { "@type": "Country", name: "Argentina" },
  knowsAbout: [
    "Desarrollo de software a medida",
    "Tiendas online",
    "E-commerce",
  ],
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SmonDev Studio",
  url: SITE_URL,
  inLanguage: "es-AR",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="desarrollo de software a medida, software a medida, desarrollo web, tiendas online, e-commerce, Store, Mercado Pago, Argentina, Patagonia, SmonDev Studio"
    />
    <meta name="author" content="SmonDev Studio" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/images/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="SmonDev Studio: ilustración de un desarrollador trabajando en su escritorio"
    />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="SmonDev Studio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={SITE_URL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={`${SITE_URL}/images/og-image.jpg`}
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={SITE_URL} />

    <!-- Datos estructurados: se serializan con JSON.stringify (antes eran JSON inválido). -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationLd)}
    ></script>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteLd)}
    ></script>
    <!-- Analytics -->
    <Analytics />

    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        if (saved) {
          if (saved === "light")
            document.documentElement.classList.add("light");
        } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
          document.documentElement.classList.add("light");
        }
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>
